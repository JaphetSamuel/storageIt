<Window x:Class="StorageIt.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:StorageIt.Views"
        xmlns:controls="clr-namespace:StorageIt.Controls"
        Title="StorageIt" Width="1560" Height="920" MinWidth="980" MinHeight="560"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        Drop="Window_Drop" DragOver="Window_DragOver" Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{x:Static views:MainWindow.ScanCommand}" />
        <KeyBinding Key="F5" Command="{x:Static views:MainWindow.RescanCommand}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static views:MainWindow.ScanCommand}" Executed="Scan_Executed" />
        <CommandBinding Command="{x:Static views:MainWindow.RescanCommand}" Executed="Rescan_Executed" CanExecute="Rescan_CanExecute" />
    </Window.CommandBindings>

    <DockPanel>
        <!-- toolbar -->
        <Border DockPanel.Dock="Top" Padding="8,6" BorderThickness="0,0,0,1" BorderBrush="#33808080">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolButton}" Command="{x:Static views:MainWindow.ScanCommand}" ToolTip="Choose drives or folders to scan (Ctrl+O)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Scan…" />
                    </StackPanel>
                </Button>
                <Button x:Name="RescanButton" Style="{StaticResource ToolButton}" Command="{x:Static views:MainWindow.RescanCommand}" ToolTip="Scan the same places again (F5)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Rescan" />
                    </StackPanel>
                </Button>
                <Button x:Name="StopButton" Style="{StaticResource ToolButton}" Click="Stop_Click" IsEnabled="False" ToolTip="Cancel the running scan">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71A;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Stop" />
                    </StackPanel>
                </Button>
                <Rectangle Width="1" Margin="6,4,10,4" Fill="#44808080" />
                <Button Style="{StaticResource ToolButton}" Click="Commands_Click" ToolTip="Create and edit your own cleanup commands">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Cleanup commands…" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- status bar -->
        <Border DockPanel.Dock="Bottom" Padding="12,5" BorderThickness="0,1,0,0" BorderBrush="#33808080">
            <DockPanel>
                <ProgressBar x:Name="ScanProgress" DockPanel.Dock="Right" Width="140" Height="4" IsIndeterminate="True"
                             Visibility="Collapsed" VerticalAlignment="Center" Margin="12,0,0,0" />
                <TextBlock x:Name="StatusText" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="1.15*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- left: tree / file types / duplicates -->
            <TabControl x:Name="LeftTabs" Grid.Column="0" Margin="6,6,0,6" SelectionChanged="LeftTabs_SelectionChanged">
                <TabItem x:Name="TreeTab" Header="Folders">
                    <views:TreePane x:Name="Tree" />
                </TabItem>
                <TabItem x:Name="ExtTab" Header="File types">
                    <views:ExtensionsPane x:Name="Exts" />
                </TabItem>
                <TabItem x:Name="DupTab" Header="Duplicates">
                    <views:DuplicatesPane x:Name="Dups" />
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- right: space map -->
            <Grid Grid.Column="2" Margin="0,6,6,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <Button x:Name="UpButton" DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Click="Up_Click" IsEnabled="False"
                            ToolTip="Show the parent folder (Backspace)" Padding="9,5">
                        <TextBlock Text="&#xE74A;" FontFamily="{StaticResource IconFont}" />
                    </Button>
                    <TextBlock x:Name="CrumbInfo" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,6,0" Opacity="0.75" />
                    <TextBlock x:Name="CrumbPath" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <Border Grid.Row="1" BorderThickness="1" BorderBrush="#33808080" CornerRadius="4" ClipToBounds="True">
                    <controls:TreemapControl x:Name="Map"
                        Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"
                        KeyDown="Map_KeyDown" />
                </Border>

                <ItemsControl x:Name="Legend" Grid.Row="2" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,2">
                                <Border Width="11" Height="11" CornerRadius="3" Background="{Binding Brush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SizeText}" FontSize="12" Opacity="0.6" Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
