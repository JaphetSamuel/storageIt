<Window x:Class="StorageIt.Views.ScanTargetsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose what to scan" Width="620" Height="560" MinWidth="520" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="90" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Drives" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,6" />
        <ListView x:Name="DriveList" Grid.Row="1" SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="170" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Subtitle}" Opacity="0.7" FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding UsedFraction, Mode=OneWay}" Height="6" />
                            <TextBlock Text="{Binding UsageText}" FontSize="11" Opacity="0.7" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <DockPanel Grid.Row="2" Margin="0,14,0,6">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Add folder…" Click="AddFolder_Click" Padding="12,4" Margin="0,0,6,0" />
                <Button Content="Remove" Click="RemoveFolder_Click" Padding="12,4" />
            </StackPanel>
            <TextBlock Text="Folders" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
        </DockPanel>
        <Grid Grid.Row="3">
            <ListBox x:Name="FolderList" SelectionMode="Extended" />
            <TextBlock x:Name="FolderHint" Text="Add one or more folders, or drop a folder on the main window."
                       HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55" IsHitTestVisible="False" />
        </Grid>

        <DockPanel Grid.Row="4" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="ScanButton" Content="Scan" IsDefault="True" Click="Scan_Click" Padding="22,5" Margin="0,0,8,0" />
                <Button Content="Cancel" IsCancel="True" Padding="16,5" />
            </StackPanel>
            <TextBlock x:Name="Note" TextWrapping="Wrap" Opacity="0.65" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"
                       Text="Some system folders need administrator rights; anything StorageIt cannot read is skipped and counted." />
        </DockPanel>
    </Grid>
</Window>
