<UserControl x:Class="StorageIt.Views.DuplicatesPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- search options -->
        <WrapPanel Grid.Row="0" Margin="8,8,8,4">
            <TextBlock Text="Look in" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="ScopeBox" Width="170" SelectedIndex="0" Margin="0,0,14,4">
                <ComboBoxItem Content="Everything scanned" />
                <ComboBoxItem Content="Folder shown in the map" />
            </ComboBox>
            <TextBlock Text="Ignore files under" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="MinSizeBox" Width="90" SelectedIndex="2" Margin="0,0,14,4">
                <ComboBoxItem Content="1 KB" Tag="1024" />
                <ComboBoxItem Content="100 KB" Tag="102400" />
                <ComboBoxItem Content="1 MB" Tag="1048576" />
                <ComboBoxItem Content="10 MB" Tag="10485760" />
                <ComboBoxItem Content="100 MB" Tag="104857600" />
            </ComboBox>
            <CheckBox x:Name="SkipSystemBox" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,4"
                      Content="Skip Windows and Program Files"
                      ToolTip="Those folders hold many intentional copies. Deleting them can break Windows or programs." />
        </WrapPanel>

        <DockPanel Grid.Row="1" Margin="8,0,8,6">
            <Button x:Name="FindButton" DockPanel.Dock="Left" Content="Find duplicates" Padding="14,5" Click="FindButton_Click" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                       Text="Finds files with identical content, biggest waste first." Opacity="0.8" />
        </DockPanel>

        <ProgressBar x:Name="Progress" Grid.Row="1" Height="3" VerticalAlignment="Bottom" Visibility="Collapsed" />

        <!-- results -->
        <ListView x:Name="ResultList" Grid.Row="2" BorderThickness="0" SelectionMode="Extended"
                  VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  SelectionChanged="ResultList_SelectionChanged"
                  PreviewMouseRightButtonDown="ResultList_PreviewMouseRightButtonDown"
                  ContextMenuOpening="ResultList_ContextMenuOpening"
                  MouseDoubleClick="ResultList_MouseDoubleClick"
                  PreviewKeyDown="ResultList_PreviewKeyDown">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource ListRowStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsHeader}" Value="True">
                            <Setter Property="Background" Value="#22808080" />
                            <Setter Property="Margin" Value="0,6,0,0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="6,3">
                        <!-- group header -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding HeaderVisibility}">
                            <Border Width="10" Height="10" CornerRadius="2" Margin="0,0,8,0" VerticalAlignment="Center" Background="{Binding Swatch}" />
                            <TextBlock Text="{Binding HeaderTitle}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding HeaderDetail}" Margin="10,0,0,0" Opacity="0.75" />
                        </StackPanel>
                        <!-- one copy -->
                        <DockPanel Visibility="{Binding FileVisibility}" Margin="14,0,0,0">
                            <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,8,0" DockPanel.Dock="Left" />
                            <TextBlock Text="{Binding ModifiedText}" DockPanel.Dock="Right" Margin="12,0,0,0" Opacity="0.7" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PathText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPathText}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock x:Name="EmptyText" Grid.Row="2" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" TextAlignment="Center" Margin="24" Opacity="0.6" />

        <!-- actions on the checked copies -->
        <WrapPanel Grid.Row="3" Margin="8,6">
            <TextBlock Text="Check:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <Button Content="all but oldest" Click="KeepOldest_Click" Margin="0,0,6,4" Padding="8,3" ToolTip="In every group, keep the copy with the oldest date and check the rest." />
            <Button Content="all but newest" Click="KeepNewest_Click" Margin="0,0,6,4" Padding="8,3" />
            <Button Content="none" Click="ClearChecks_Click" Margin="0,0,14,4" Padding="8,3" />
            <CheckBox x:Name="HighlightBox" Content="Show in map" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,4"
                      Checked="HighlightBox_Changed" Unchecked="HighlightBox_Changed" />
            <Button x:Name="DeleteButton" Content="Delete checked…" Click="DeleteChecked_Click" IsEnabled="False" Margin="0,0,0,4" Padding="12,3" />
        </WrapPanel>
    </Grid>
</UserControl>
